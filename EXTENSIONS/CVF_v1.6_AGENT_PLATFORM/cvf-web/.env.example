# CVF Web UI - Environment Configuration
# Copy this file to .env.local and fill in your API keys

# ===========================================
# AI Provider API Keys
# ===========================================
# At least ONE provider must be configured

# OpenAI (GPT-4, GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude 3.5)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google (Gemini 2.0)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Alibaba DashScope / Qwen
# Canonical env for all CVF live tests, execute routes, and runtime validation.
# Compatibility aliases still accepted in code: CVF_BENCHMARK_ALIBABA_KEY, CVF_ALIBABA_API_KEY
ALIBABA_API_KEY=

# DeepSeek
# OpenAI-compatible endpoint: https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=

# ===========================================
# Default Provider
# ===========================================
# Options: openai, claude, gemini, alibaba, openrouter, deepseek
DEFAULT_AI_PROVIDER=openai

# ===========================================
# LPCI Context-To-LLM Binding
# ===========================================
# All LPCI values are server-only. Never use NEXT_PUBLIC_ for these variables.
# The model is a required exact provider/model pair. No implicit model default.
LPCI_LLM_MODEL=openai/gpt-4o
# Secret value intentionally omitted. Missing or trim-empty means not configured.
LPCI_LLM_API_KEY=
# Hosted release requires this exact endpoint; no source default satisfies hosted readiness.
LPCI_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# Opaque, non-secret version shared by all three names in the atomic bundle.
LPCI_LLM_CONFIG_BUNDLE_VERSION=replace-with-opaque-bundle-version
# Purpose-bound allowlist of SHA-256 actor references, never raw service identities.
LPCI_QUERY_SERVICE_ACTOR_ALLOWLIST=

# Distributed release quota. Memory mode is deterministic-test-only.
CVF_RATE_LIMIT_STORE=redis
CVF_RATE_LIMIT=30
CVF_PROVIDER_QUOTA_PER_MIN=30
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# CVF v1.6.1 Governance Engine
# ===========================================
# URL of the FastAPI governance server (default: http://localhost:8000)
GOVERNANCE_ENGINE_URL=http://localhost:8000

# Enable/disable governance engine integration (default: true)
# When disabled, falls back to client-side governance logic
GOVERNANCE_ENGINE_ENABLED=true

# Request timeout in ms (default: 5000)
GOVERNANCE_ENGINE_TIMEOUT=5000

# ===========================================
# CVF MAO Durable Run Readout (read-only)
# ===========================================
# Explicit local root directory for an existing MaoFileRunStore. Absent or
# blank means the durable-run operator readout reports UNAVAILABLE; this
# route never creates a directory or selects a fallback path.
# CVF_MAO_DURABLE_RUN_PATH=

# ===========================================
# Authentication
# ===========================================
# CVF_ADMIN_USER=admin
# CVF_ADMIN_PASS=admin123
# CVF_SERVICE_TOKEN=your-service-token-here
# CVF_INTERNAL_AUDIT_SECRET=required-for-admin-route-audit-posts

# ===========================================
# Optional Settings
# ===========================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable mock AI mode (UI demo only)
# NEXT_PUBLIC_CVF_MOCK_AI=1

# Optional: override model pricing JSON (for /api/pricing)
# MODEL_PRICING_JSON={"openai":{"gpt-4o":{"input":5,"output":15}}}
