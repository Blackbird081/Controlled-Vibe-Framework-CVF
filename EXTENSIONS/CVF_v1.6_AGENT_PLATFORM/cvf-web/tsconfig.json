{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "cvf-truth-kernel": ["../../CVF_TRUTH_KERNEL/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-cvf-release-gate-build/types/**/*.ts",
    ".next-cvf-release-gate-build/dev/types/**/*.ts",
    ".next-cvf-release-gate-e2e-mock/dev/types/**/*.ts",
    ".next-cvf-release-gate-e2e-mock/dev/dev/types/**/*.ts",
    ".next-cvf-release-gate-e2e-live/dev/types/**/*.ts",
    ".next-cvf-release-gate-e2e-live/dev/dev/types/**/*.ts",
    ".next-ncr-html-pilot-root/dev/types/**/*.ts",
    ".next-ncr-html-pilot-root/dev/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
