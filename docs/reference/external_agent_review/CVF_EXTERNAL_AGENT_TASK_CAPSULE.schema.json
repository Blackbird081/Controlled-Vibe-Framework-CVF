{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cvf.externalAgentTaskCapsule.v1",
  "title": "CVF External Agent Task Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocolVersion", "projectionOf", "generatedAt", "task", "cvfPublicSource", "sourceRepositories", "gateA", "gateB", "authorityEnvelope"],
  "allOf": [
    {
      "if": {
        "properties": {"task": {"properties": {"workingMode": {"enum": ["BUILD_NEW_REPOSITORY", "EXTEND_SUPPLIED_REPOSITORY", "DETACHED_IMPLEMENTATION_PROPOSAL"]}}}}
      },
      "then": {
        "required": ["protectedPaths", "ownerMap", "invariants", "verification"]
      }
    },
    {
      "if": {
        "properties": {"task": {"properties": {"workingMode": {"const": "DETACHED_IMPLEMENTATION_PROPOSAL"}}}}
      },
      "then": {
        "properties": {
          "task": {
            "properties": {"expectedReturnStatus": {"const": "EXTERNAL_RETURN_READY_FOR_LOCAL_VERIFICATION"}},
            "required": ["executionClass"]
          }
        }
      },
      "else": {
        "properties": {"task": {"properties": {"expectedReturnStatus": {"const": "COMPLETE_PENDING_LOCAL_RECONCILIATION"}}}}
      }
    }
  ],
  "$defs": {
    "consumerList": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["worker", "reviewer", "return validator"]},
      "uniqueItems": true
    },
    "freshnessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "regenerateWhen"],
      "properties": {
        "anchor": {"type": "string", "minLength": 1},
        "regenerateWhen": {"type": "string", "minLength": 1}
      }
    },
    "safeRelPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\./)(?!\\.$)(?!.*\\.\\.)(?!.*\\\\)(?!.*:)(?!.*//)(?!\\s)(?!.*\\s$).+$"
    },
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "properties": {
    "schema": {"const": "cvf.externalAgentTaskCapsule.v1"},
    "protocolVersion": {"pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "projectionOf": {"const": "cvf.external-agent-round-trip"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "objective", "workingMode", "outputRoot", "nonGoals"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "workingMode": {"enum": ["REVIEW_ONLY", "DESIGN_ONLY", "BUILD_NEW_REPOSITORY", "EXTEND_SUPPLIED_REPOSITORY", "SOURCE_PACK_PREPARATION", "DETACHED_IMPLEMENTATION_PROPOSAL"]},
        "expectedReturnStatus": {"enum": ["COMPLETE_PENDING_LOCAL_RECONCILIATION", "EXTERNAL_RETURN_READY_FOR_LOCAL_VERIFICATION"]},
        "executionClass": {"enum": ["SHARED_WORKSPACE_DELEGATED_WORKER", "DETACHED_EXTERNAL_AGENT"]},
        "outputRoot": {"type": "string", "minLength": 1},
        "outputRootPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedRootSemantics", "whenAvailable", "whenUnavailable", "allowedFallback", "evidenceFields"],
          "properties": {
            "requestedRootSemantics": {"const": "OPERATOR_PREFERRED_DESTINATION"},
            "whenAvailable": {"const": "USE_REQUESTED_OUTPUT_ROOT"},
            "whenUnavailable": {"const": "OUTPUT_ROOT_REBOUND"},
            "allowedFallback": {"const": "AUTHORIZED_WRITABLE_TASK_OR_ARTIFACT_ROOT_ONLY"},
            "evidenceFields": {"const": ["requestedOutputRoot", "actualOutputRoot", "outputRootDisposition", "reason"]}
          }
        },
        "shortObjectivePolicy": {"const": "FOCUS_WITHIN_CAPSULE_ENVELOPE_NO_STRING_EQUALITY"},
        "nonGoals": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "cvfPublicSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "sourcePosture"],
      "properties": {
        "repository": {"const": "https://github.com/Blackbird081/Controlled-Vibe-Framework-CVF.git"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourcePosture": {"enum": ["VERIFIED_LIVE_PUBLIC_MAIN_AT_CREATION", "OPERATOR_PINNED_NOT_LIVE_VERIFIED"]},
        "comparisonBaseline": {"const": "TASK_CAPSULE_PIN_NORMATIVE"},
        "liveHeadDisposition": {"const": "RECORD_DRIFT_DO_NOT_SILENTLY_REPIN"}
      }
    },
    "sourceRepositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "usage"],
        "properties": {
          "repository": {"type": "string", "format": "uri"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "usage": {"const": "REFERENCE_AND_ANALYSIS"},
          "licenseExpression": {"type": "string", "pattern": "\\S"},
          "licenseSource": {"type": "string", "format": "uri"},
          "immutableReferences": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri"},
            "uniqueItems": true
          }
        }
      }
    },
    "gateA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requiredBefore", "requiredEvidence", "terminalStates"],
      "properties": {
        "name": {"const": "SOURCE_OWNER_OVERLAP"},
        "requiredBefore": {"const": "DESIGN_OR_CODE"},
        "requiredEvidence": {"type": "array", "minItems": 4, "items": {"type": "string"}, "uniqueItems": true},
        "terminalStates": {"const": ["PASS", "RETURN_FOR_REPAIR", "BLOCKED"]}
      }
    },
    "gateB": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "opensOnlyWhen", "requiredEvidence"],
      "properties": {
        "name": {"const": "DESIGN_CODE_TEST"},
        "opensOnlyWhen": {"const": "gateA=PASS"},
        "requiredEvidence": {"type": "array", "minItems": 5, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "authorityEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "push", "publication", "deployment", "providerCalls", "credentials", "destructiveActions"],
      "properties": {
        "commit": {"const": false},
        "push": {"const": false},
        "publication": {"const": false},
        "deployment": {"const": false},
        "providerCalls": {"const": false},
        "credentials": {"const": false},
        "destructiveActions": {"const": false}
      }
    },
    "protectedPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "freshness", "paths"],
      "properties": {
        "consumers": {"$ref": "#/$defs/consumerList"},
        "freshness": {"$ref": "#/$defs/freshnessRule"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safeRelPath"},
          "uniqueItems": true
        }
      }
    },
    "ownerMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "freshness", "owners"],
      "properties": {
        "consumers": {"$ref": "#/$defs/consumerList"},
        "freshness": {"$ref": "#/$defs/freshnessRule"},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "symbol", "competingOwnersChecked"],
            "properties": {
              "path": {"$ref": "#/$defs/safeRelPath"},
              "symbol": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "competingOwnersChecked": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/nonBlankString"},
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "freshness", "mustPreserve", "forbiddenTransitions"],
      "properties": {
        "consumers": {"$ref": "#/$defs/consumerList"},
        "freshness": {"$ref": "#/$defs/freshnessRule"},
        "mustPreserve": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "forbiddenTransitions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "freshness", "focusedTests", "negativeCases", "deterministicChecks", "requiredOutputs"],
      "properties": {
        "consumers": {"$ref": "#/$defs/consumerList"},
        "freshness": {"$ref": "#/$defs/freshnessRule"},
        "focusedTests": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "negativeCases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "deterministicChecks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
