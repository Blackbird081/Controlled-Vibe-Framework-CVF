# Generated by the CVF workspace bootstrap from the pinned downstream gate profile
# (cvf.downstreamGateProfile@1.1.0). Editing this file changes the pinned rendering
# and is reported as CI_WORKFLOW_DRIFT by the Core doctor. A YAML token is NOT executed CI evidence.
# The three pins below are checked against the actual bytes of scripts/cvf_gates before any project
# module is imported. They live in project-controlled YAML, so they are tamper evidence for inconsistent
# edits, not an independent trust root; the independent anchor is the Core doctor (--trusted).
name: cvf-downstream-gates
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  cvf-downstream-gates:
    runs-on: ubuntu-latest
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      CVF_DG_BASE: ${{ github.event.pull_request.base.sha || github.event.before }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Run mandatory CVF downstream gates (pr-ci phase)
        run: >-
          python scripts/cvf_gates/cvf_downstream_gate_runner.py run --phase pr-ci
          --project-root .
          --base-from-env CVF_DG_BASE --head HEAD
          --expect-profile-sha256 {{PROFILE_SHA256}}
          --expect-runner-sha256 {{RUNNER_SHA256}}
          --expect-bundle-sha256 {{BUNDLE_SHA256}}
